#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xgpio.h"
#include "xtmrctr.h"
#include "xscugic.h"
#include "xil_exception.h"
#include "sleep.h"

#define TIMER_DEVICE_ID XPAR_AXI_TIMER_0_DEVICE_ID
#define TIMER_INTR XPAR_FABRIC_AXI_TIMER_0_INTERRUPT_INTR
#define SCUGIC_DEVICE_ID XPAR_SCUGIC_0_DEVICE_ID
#define TIMER_CHANNEL_1 0
#define TIMER_CHANNEL_2 1
#define TIMER_PERIOD_US 10000
#define TIMER_PWM_HIGH_TIME_US 7000

#define GPIO_DEVICE_ID XPAR_AXI_GPIO_0_DEVICE_ID
#define GPIO_CHANNEL 1
#define IN1_PIN              0
#define IN2_PIN              1

XTmrCtr xTmrCtr_Inst;
XGpio Gpio;
XScuGic xScuGic_Inst;

void xTmrCtr_Int_Handler(void *CallBackRef, u8 TmrCtrNumber)
{
}

u32 xTmr_US_To_RegValue(u32 US) {
    return 0xFFFFFFFF - (50 * US);
}

u32 xTmr_US_To_NS(u32 US) {
    return US * 1000;
}

int XTmrCtr_Init(XTmrCtr *xTmrCtr_Ptr, u32 DeviceId)
{
    int Status;

    Status = XTmrCtr_Initialize(xTmrCtr_Ptr, DeviceId);
    if (Status != XST_SUCCESS)
    {
        xil_printf("Timer initialisatie mislukt!\n\r");
        return XST_FAILURE;
    }

    Status = XTmrCtr_SelfTest(xTmrCtr_Ptr, 2 - 1);
    if (Status != XST_SUCCESS) {
        return XST_FAILURE;
    }

    XTmrCtr_SetHandler(xTmrCtr_Ptr, xTmrCtr_Int_Handler, xTmrCtr_Ptr);
    XTmrCtr_SetResetValue(xTmrCtr_Ptr, TIMER_CHANNEL_1, xTmr_US_To_RegValue(TIMER_PERIOD_US));
    XTmrCtr_SetResetValue(xTmrCtr_Ptr, TIMER_CHANNEL_2, xTmr_US_To_RegValue(TIMER_PERIOD_US));

    XTmrCtr_SetOptions(xTmrCtr_Ptr, TIMER_CHANNEL_1, XTC_INT_MODE_OPTION | XTC_AUTO_RELOAD_OPTION);
    XTmrCtr_SetOptions(xTmrCtr_Ptr, TIMER_CHANNEL_2, XTC_INT_MODE_OPTION | XTC_AUTO_RELOAD_OPTION);

    XTmrCtr_PwmConfigure(xTmrCtr_Ptr, xTmr_US_To_NS(TIMER_PERIOD_US), xTmr_US_To_NS(TIMER_PWM_HIGH_TIME_US));

    return XST_SUCCESS;
}


int XScuGic_Init(XScuGic *ScuGic_Ptr, XTmrCtr *xTmrCtr_Ptr)
{
    XScuGic_Config *IntcConfig;

    IntcConfig = XScuGic_LookupConfig(SCUGIC_DEVICE_ID);
    if (IntcConfig == NULL) {
        xil_printf("Geen interrupt configuratie gevonden!\n\r");
        return XST_FAILURE;
    }

    XScuGic_CfgInitialize(ScuGic_Ptr, IntcConfig, IntcConfig->CpuBaseAddress);

    Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT, (Xil_ExceptionHandler)XScuGic_InterruptHandler, ScuGic_Ptr);
    Xil_ExceptionEnable();

    XScuGic_Connect(ScuGic_Ptr, TIMER_INTR, (Xil_ExceptionHandler)XTmrCtr_InterruptHandler, (void *)xTmrCtr_Ptr);
    XScuGic_Enable(ScuGic_Ptr, TIMER_INTR);

    return XST_SUCCESS;
}

void MotorMoveForward()
{
    XGpio_DiscreteWrite(&Gpio, GPIO_CHANNEL, (1 << IN1_PIN) | (1 << IN2_PIN));
    xil_printf("Motor beweegt rechtdoor\n\r");
}

void MotorTurnLeft()
{
    XGpio_DiscreteWrite(&Gpio, GPIO_CHANNEL, (1 << IN1_PIN) | (0 << IN2_PIN));
    xil_printf("Motor draait naar links\n\r");
}

void MotorTurnRight()
{
    XGpio_DiscreteWrite(&Gpio, GPIO_CHANNEL, (0 << IN1_PIN) | (1 << IN2_PIN));
    xil_printf("Motor draait naar rechts\n\r");
}

int main()
{
    init_platform();

    if (XTmrCtr_Init(&xTmrCtr_Inst, TIMER_DEVICE_ID) != XST_SUCCESS) {
        xil_printf("Timer initialisatie mislukt!\n\r");
        return XST_FAILURE;
    }

    if (XScuGic_Init(&xScuGic_Inst, &xTmrCtr_Inst) != XST_SUCCESS) {
        xil_printf("Interruptcontroller initialisatie mislukt!\n\r");
        return XST_FAILURE;
    }

    if (XGpio_Initialize(&Gpio, GPIO_DEVICE_ID) != XST_SUCCESS) {
        xil_printf("GPIO initialisatie mislukt!\n\r");
        return XST_FAILURE;
    }

    XTmrCtr_Start(&xTmrCtr_Inst, TIMER_CHANNEL_1);
    XTmrCtr_Start(&xTmrCtr_Inst, TIMER_CHANNEL_2);
    XTmrCtr_PwmEnable(&xTmrCtr_Inst);

    xil_printf("Motorbesturing is nu actief...\n\r");
    while (1)
    {
    MotorMoveForward();
    usleep(5000000);

    MotorTurnLeft();
    usleep(5000000);

    MotorTurnRight();
    usleep(5000000);
    }

    cleanup_platform();
    return 0;
}
