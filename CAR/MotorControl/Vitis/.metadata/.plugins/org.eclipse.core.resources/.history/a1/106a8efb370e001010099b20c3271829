#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xgpio.h"
#include "xtmrctr.h"
#include "xscugic.h"
#include "xil_exception.h"
#include "sleep.h"

#define TIMER_DEVICE_ID XPAR_AXI_TIMER_0_DEVICE_ID
#define TIMER_INTR XPAR_FABRIC_AXI_TIMER_0_INTERRUPT_INTR
#define SCUGIC_DEVICE_ID XPAR_SCUGIC_0_DEVICE_ID
#define TIMER_CHANNEL_1 0
#define TIMER_CHANNEL_2 1
#define TIMER_PERIOD_US 10000
#define TIMER_PWM_HIGH_TIME_US 7000

#define GPIO_DEVICE_ID XPAR_AXI_GPIO_0_DEVICE_ID
#define GPIO_CHANNEL 1
#define IN1_PIN 0
#define IN2_PIN 1
#define IN3_PIN 2
#define IN4_PIN 3

XTmrCtr xTmrCtr_Inst;
XGpio Gpio;
XScuGic xScuGic_Inst;

void MotorMoveForward()
{
    XGpio_DiscreteWrite(&Gpio, GPIO_CHANNEL, (1 << IN1_PIN) | (0 << IN2_PIN) | (1 << IN3_PIN) | (0 << IN4_PIN));
    xil_printf("Beide motoren bewegen vooruit\n\r");
}

void MotorMoveBackward()
{
    XGpio_DiscreteWrite(&Gpio, GPIO_CHANNEL, (0 << IN1_PIN) | (1 << IN2_PIN) | (0 << IN3_PIN) | (1 << IN4_PIN));
    xil_printf("Beide motoren bewegen achteruit\n\r");
}

void MotorTurnLeft()
{
    XGpio_DiscreteWrite(&Gpio, GPIO_CHANNEL, (1 << IN1_PIN) | (0 << IN2_PIN) | (0 << IN3_PIN) | (1 << IN4_PIN));
    xil_printf("Motor draait naar links\n\r");
}

void MotorTurnRight()
{
    XGpio_DiscreteWrite(&Gpio, GPIO_CHANNEL, (0 << IN1_PIN) | (1 << IN2_PIN) | (1 << IN3_PIN) | (0 << IN4_PIN));
    xil_printf("Motor draait naar rechts\n\r");
}

int main()
{
    init_platform();

    if (XGpio_Initialize(&Gpio, GPIO_DEVICE_ID) != XST_SUCCESS) {
        xil_printf("GPIO initialisatie mislukt!\n\r");
        return XST_FAILURE;
    }

    xil_printf("Motorbesturing actief...\n\r");

    while (1)
    {
        MotorMoveBackward();
        sleep(5000000);

        MotorTurnLeft();
        sleep(5000000);

        MotorMoveForward();
        sleep(5000000);

        MotorTurnRight();
        sleep(5000000);
    }

    cleanup_platform();
    return 0;
}
